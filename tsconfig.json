{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["cypress", "node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "allowJs": true
  },
  "include": [
    "cypress/**/*.ts",
    "cypress/**/*.js",
    "cypress.config.ts",
    "cypress.config.js"
  ]
}

